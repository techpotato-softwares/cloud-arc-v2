# ArcForge Node — copy to .env and fill values. Never commit real secrets.

IS_LOCAL=true
ENVIRONMENT=dev
APP_NAME=arcforge
AWS_REGION=us-east-1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcforge
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSL=false
DATABASE_URL=postgresql://postgres:secret@localhost:5432/arcforge

JWT_SECRET=local-dev-jwt-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
JWT_EXPIRES_IN=45m
JWT_REFRESH_EXPIRES_IN=7d

S3_BUCKET_NAME=arcforge-files-dev
API_PORT=4000
