# Prefer api/.env.example — this file is kept for buyers who start from the kit root.
# Copy either:
#   cp api/.env.example api/.env
#   cp .env.example api/.env

IS_LOCAL=true
ENVIRONMENT=dev
APP_NAME=arcforge
AWS_REGION=us-east-1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=arcforge
DB_USERNAME=postgres
DB_PASSWORD=secret
DATABASE_URL=postgresql://postgres:secret@localhost:5432/arcforge

JWT_SECRET=local-dev-jwt-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me

AI_PROVIDER=stub
# OPENAI_API_KEY=
# BEDROCK_MODEL=anthropic.claude-3-haiku
