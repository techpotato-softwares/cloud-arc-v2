JWT_SECRET=replace-me
OPENAI_API_KEY=
JEV_API_KEY=
FORGEARC_AI_CLOUD=local
AWS_REGION=us-east-1
GCP_PROJECT=
GCP_LOCATION=us-central1
FORGEARC_AI_BUCKET=
FORGEARC_AI_SECRET_ID=
FORGEARC_AI_QUEUE_URL=
FORGEARC_AI_FIRESTORE_DATABASE=(default)
FORGEARC_AI_WEBHOOK_URL=
FORGEARC_AI_WEBHOOK_SECRET=
DATABASE_URL=postgresql+psycopg://forgearc:forgearc@localhost:5433/forgearc_ai
# Production identity is injected by CDK or Terraform.
FORGEARC_AI_AUTH_MODE=local
FORGEARC_AI_OIDC_ISSUER=
FORGEARC_AI_OIDC_AUDIENCE=
FORGEARC_AI_OIDC_JWKS_URL=
FORGEARC_AI_OIDC_TENANT_CLAIM=custom:tenant_id
FORGEARC_AI_OIDC_PERMISSIONS_CLAIM=permissions
FORGEARC_AI_OIDC_MODULES_CLAIM=modules
FORGEARC_AI_OIDC_GROUPS_CLAIM=cognito:groups
FORGEARC_AI_OIDC_DEFAULT_MODULES=ai
FORGEARC_AI_GROUP_PERMISSIONS=
FORGEARC_AI_CORS_ORIGINS=
# Optional application cache (TTL required; stampede mutex on by default).
FORGEARC_CACHE_TTL_MS=60000
FORGEARC_CACHE_JITTER_RATIO=0.1
FORGEARC_CACHE_STAMPEDE_PROTECTION=true
FORGEARC_CACHE_COALESCE_TIMEOUT_MS=5000
FORGEARC_CACHE_NEGATIVE=false
FORGEARC_CACHE_ERRORS=false
FORGEARC_CACHE_KEY_PREFIX=ai:
