{
  "name": "@forgearc/cdk",
  "version": "1.0.0",
  "description": "CDK Infrastructure for ForgeArc API",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"bin/**/*.ts\" \"lib/**/*.ts\"",
    "build:api": "pnpm --filter @forgearc/api-host build:all",
    "presynth": "pnpm build:api",
    "synth": "cdk synth ApiStack-dev",
    "synth:dev": "cdk synth ApiStack-dev",
    "synth:qa": "cdk synth ApiStack-qa",
    "synth:prod": "cdk synth ApiStack-prod",
    "diff:dev": "cdk diff ApiStack-dev",
    "deploy:dev": "pnpm build:api && cdk deploy ApiStack-dev --require-approval never",
    "deploy:qa": "pnpm build:api && cdk deploy ApiStack-qa --require-approval never",
    "deploy:prod": "pnpm build:api && cdk deploy ApiStack-prod",
    "destroy:dev": "cdk destroy ApiStack-dev",
    "clean": "rimraf cdk.out",
    "bootstrap": "cdk bootstrap"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.115.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "aws-cdk": "^2.115.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.8",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2"
  },
  "private": true
}
