{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "rootDir": "../..",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@forgearc/shared": ["../../packages/shared/src"],
      "@forgearc/shared/*": ["../../packages/shared/src/*"],
      "/opt/nodejs/dist": ["../../packages/shared/src"],
      "/opt/nodejs/dist/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "../../modules/**/*",
    "../../packages/shared/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "../../packages/shared/bundled"]
}
